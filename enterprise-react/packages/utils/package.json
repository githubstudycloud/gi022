{
  "name": "@enterprise/utils",
  "version": "0.0.1",
  "description": "Enterprise shared utilities — zero runtime dependencies",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@enterprise/tsconfig": "workspace:*",
    "@enterprise/eslint-config": "workspace:*",
    "@enterprise/vite-config": "workspace:*",
    "@testing-library/jest-dom": "^6.4.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
