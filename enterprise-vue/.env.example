# =============================================================
# 环境变量模板 - 复制为 .env.local 并填入真实值
# =============================================================

# 应用环境: development | staging | production
NODE_ENV=development

# API 基础地址
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ADMIN_API_BASE_URL=http://localhost:8081/api/v1

# CDN / 静态资源地址（生产环境使用）
VITE_CDN_BASE_URL=

# 应用标题
VITE_APP_TITLE=Enterprise App

# 加密密钥（不可提交真实值）
VITE_ENCRYPT_KEY=

# 功能开关
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_MOCK=true

# Sentry DSN（错误监控）
VITE_SENTRY_DSN=
