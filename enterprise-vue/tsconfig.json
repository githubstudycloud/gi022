{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@enterprise/ui": ["packages/ui/src/index.ts"],
      "@enterprise/utils": ["packages/utils/src/index.ts"],
      "@enterprise/types": ["packages/types/src/index.ts"],
      "@enterprise/api": ["packages/api/src/index.ts"],
      "@enterprise/stores": ["packages/stores/src/index.ts"],
      "@enterprise/config": ["packages/config/src/index.ts"]
    }
  },
  "exclude": ["**/node_modules", "**/dist", "**/.turbo"]
}
